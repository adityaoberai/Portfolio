{
	"name": "aditya-oberai-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "node build",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --import ./tests/ts-hooks.mjs --test tests/movement.test.mjs tests/content.test.mjs",
		"test:e2e": "playwright test",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"og": "node og/render.js",
		"assets": "node scripts/derive-assets.mjs",
		"images": "node --import ./tests/ts-hooks.mjs scripts/derive-images.mjs",
		"perf": "node scripts/perf.mjs",
		"content": "node --import ./tests/ts-hooks.mjs scripts/content.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@fontsource-variable/newsreader": "^5.2.10",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.3.2",
		"@types/three": "0.186.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.14.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.0.0",
		"svelte-check": "^4.7.2",
		"tailwindcss": "^4.3.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.45.0",
		"vite": "^6.0.0"
	},
	"dependencies": {
		"three": "0.186.1"
	}
}
